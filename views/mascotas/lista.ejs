<header class="cabecera-pagina">
    <div>
        <p class="etiqueta">CATÁLOGO</p>
        <h1><%= titulo %></h1>
    </div>
    <a class="boton" href="/mascotas/nuevo">Agregar mascota</a>
 </header>
<% if (mascotas.length === 0) { %>
    <p>No hay mascotas para mostrar.</p>
<% } else { %>
 <section class="grilla" aria-label="Mascotas disponibles">
    <% mascotas.forEach((mascota) => { %>
    <article class="tarjeta">
        <h2><%= mascota.nombre %></h2>
        <p class="especie"><%= mascota.especie.toLocaleString("es-AR") %></p>
        <p class="edad"><%= mascota.edad.toLocaleString("es-AR") %></p>
        <p class="descripcion"><%= mascota.descripcion.toLocaleString("es-AR") %></p>
        <a href="/mascotas/<%= mascota.id %>">Ver detalle</a>
    </article>
    <% }) %>
 </section>
<% } %>