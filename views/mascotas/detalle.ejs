<article class="detalle">
    <p class="etiqueta"><%= mascota.categoria %></p>
    <h1><%= mascota.id %> - <%= mascota.nombre %></h1>
    <img src="/img/mascotas.jpg" alt="" width="50" height="50" class="img-mascota" src="<%= mascota.imagen %>" alt="Foto de <%= mascota.nombre %>" >
    <p>Especie: <%= mascota.especie %></p>
    <p>Edad: <%= mascota.edad %></p>
    <p>Descripción: <%= mascota.descripcion %></p>
    <p>Estado: <%= mascota.estado %></p>
    <a href="/mascotas">Volver al catálogo</a>
</article>
