<article class="detalle">
    <p class="etiqueta"><%= mascota.categoria %></p>
    <p><%= mascota.especie %></p>
    <h1><%= mascota.nombre %></h1>
    <p class="edad"><%= mascota.edad.toLocaleString("es-AR") %></p>
    <p><%= mascota.descripcion %></p>
    <a href="/mascotas">Volver al catálogo</a>
</article>